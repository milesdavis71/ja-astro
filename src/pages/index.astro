---
import TwoColumnLayout from '../layouts/TwoColumnLayout.astro'
import NewsCards from '../components/NewsCards.astro'
import HighlightedActivities from '../components/HighlightedActivities.astro'

export const frontmatter = {
  title: '',
  metaTitle: 'Főoldal',
  showPageTitle: false,
  contentClass: 'pt-0 home-main-content',
}

const postModules = import.meta.glob('../content/news/*.mdx', { eager: true })
const newsPosts = Object.entries(postModules)
  .map(([file, mod]) => ({ file, ...(mod as any) }))
  .filter((post) => post.frontmatter?.draft !== true)

const featuredNews = newsPosts
  .map((post, index) => {
    const slug =
      post.file
        ?.split('/')
        .pop()
        ?.replace(/\.mdx?$/, '') || `news-${index}`

    return {
      id: index + 1,
      title: post.frontmatter?.title || 'Cím nélkül',
      slug,
      date: post.frontmatter?.date
        ? new Date(post.frontmatter.date).toISOString().split('T')[0]
        : '2026-02-23',
      excerpt: post.frontmatter?.excerpt || '',
      image: post.frontmatter?.thumbnail || '/images/ja-logo-magenta-blue-fekvo-for-dark-bg.svg',
      category: 'Hír',
    }
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3)

const stats = [
  { value: '6500+', label: 'ösztöndíjas' },
  { value: '60+', label: 'SZTE-s osztálykirándulás csoport' },
  { value: '1300+', label: 'érettségi tanfolyamot elvégző' },
  { value: '1100+', label: 'TM felkészítőt elvégző' },
  { value: '35', label: 'partneriskola' },
  { value: '600+', label: 'TM mentor' },
  { value: '5165+', label: 'vetélkedőink résztvevői' },
  { value: '1200+', label: 'mentorált diák' },
]
---

<TwoColumnLayout {frontmatter}>
  <section class="grid gap-4 py-2 md:grid-cols-2">
    <HighlightedActivities featured onlyFirst />

    <aside class="rounded-md border border-slate-300 bg-white p-3">
      <h2 class="mb-2 text-left text-lg text-[color:var(--primary-color)]">Junior Akadémia számokban</h2>
      <dl class="grid grid-cols-1 gap-1.5 sm:grid-cols-2">
        {
          stats.map((stat) => (
            <div class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-2">
              <dt class="text-xl font-bold leading-none text-[color:var(--secondary-color)]">
                {stat.value}
              </dt>
              <dd class="mt-1 text-sm leading-snug text-slate-700">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </section>

  <HighlightedActivities skipFirst flush compact columns="grid-cols-1 gap-3 md:grid-cols-3" />

  <section id="news" class="bg-gray-50 py-4">
    <div class="mx-auto max-w-7xl">
      <h2 id="hirek" class="text-center">Hírek</h2>
      <NewsCards items={featuredNews} />
    </div>
  </section>

</TwoColumnLayout>
