---
const { frontmatter } = Astro.props
const contentClass = frontmatter?.contentClass || ''
---
<main class={`main-content-column ${contentClass}`}>
  <!-- Page Title -->
  {frontmatter?.title && frontmatter?.showPageTitle !== false && !frontmatter?.hidePageTitle && (
    <header class="mb-8">
      <h1 class="page-title-bar">
        {frontmatter.title}
      </h1>
      {frontmatter?.description && (
        <p class="text-gray-600">{frontmatter.description}</p>
      )}
    </header>
  )}
  <slot />
</main>
