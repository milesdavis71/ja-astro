---
const schools = ['Budapesti Gimnázium', 'Szegedi Technikum', 'Debreceni Akadémia']
---

<div class="mx-auto max-w-2xl rounded-lg bg-white p-6 shadow-lg">
  <h2 class="mb-6 text-2xl font-bold">Junior Viadala Jelentkezés</h2>

  <form id="main-form" class="space-y-4">
    <select id="school-select" name="school" required class="w-full rounded border p-3">
      <option value="">Válassza ki az iskoláját...</option>
      {schools.map((school) => <option value={school}>{school}</option>)}
      <option value="none">Nincs a listában</option>
    </select>

    <div id="error-msg" class="hidden rounded bg-red-100 p-4 text-red-700">
      Sajnos, ha nem találja az iskoláját, nem tud jelentkezni a Viadalra.
    </div>

    <div id="form-content" class="space-y-4">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <input
          type="email"
          name="email"
          placeholder="Saját email (belépéshez)"
          required
          class="rounded border p-2"
        />
        <input
          type="password"
          name="password"
          placeholder="Jelszó"
          required
          class="rounded border p-2"
        />
      </div>

      <hr />
      <h3 class="font-bold text-gray-700">Csapattársak adatai (3 fő)</h3>

      <div class="space-y-2">
        <input type="text" name="s1_n" placeholder="1. társ neve" required class="w-full rounded border p-2" />
        <input
          type="email"
          name="s1_e"
          placeholder="1. társ email"
          required
          class="w-full rounded border p-2"
        />
      </div>

      <div class="space-y-2">
        <input type="text" name="s2_n" placeholder="2. társ neve" required class="w-full rounded border p-2" />
        <input
          type="email"
          name="s2_e"
          placeholder="2. társ email"
          required
          class="w-full rounded border p-2"
        />
      </div>

      <div class="space-y-2">
        <input type="text" name="s3_n" placeholder="3. társ neve" required class="w-full rounded border p-2" />
        <input
          type="email"
          name="s3_e"
          placeholder="3. társ email"
          required
          class="w-full rounded border p-2"
        />
      </div>

      <button
        type="submit"
        id="sub-btn"
        class="w-full rounded-md bg-[var(--button-color)] py-3 font-bold text-white transition hover:bg-[var(--button-hover-color)]"
      >
        Jelentkezés beküldése
      </button>
    </div>
  </form>
</div>

<script>
  const select = document.getElementById('school-select') as HTMLSelectElement | null
  const error = document.getElementById('error-msg')
  const content = document.getElementById('form-content')
  const mainForm = document.getElementById('main-form') as HTMLFormElement | null
  const submitBtn = document.getElementById('sub-btn') as HTMLButtonElement | null

  const readJsonResponse = async (response: Response) => {
    const payload = await response.json().catch(() => null)
    if (!response.ok) {
      throw new Error(payload?.message || `HTTP ${response.status}`)
    }
    return payload
  }

  if (select && error && content && mainForm && submitBtn) {
    select.addEventListener('change', () => {
      if (select.value === 'none') {
        error.classList.remove('hidden')
        content.classList.add('hidden')
      } else {
        error.classList.add('hidden')
        content.classList.remove('hidden')
      }
    })

    mainForm.addEventListener('submit', async (event) => {
      event.preventDefault()

      if (select.value === 'none') {
        error.classList.remove('hidden')
        content.classList.add('hidden')
        return
      }

      const formData = new FormData(mainForm)
      const payload = Object.fromEntries(formData)
      const originalText = submitBtn.textContent

      try {
        submitBtn.disabled = true
        submitBtn.textContent = 'Küldés folyamatban...'

        const response = await fetch('/api/handler.php?action=register_student', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        })

        const result = await readJsonResponse(response)
        if (!result?.success) {
          throw new Error(result?.message || 'A jelentkezés nem sikerült.')
        }

        alert(
          'Sikeres regisztráció!' +
            (result.email_sent
              ? '\nVisszaigazoló email elküldve.'
              : '\nMegjegyzés: A visszaigazoló emailt nem sikerült elküldeni.')
        )
        mainForm.reset()
      } catch (error: any) {
        alert('Hiba: ' + (error?.message || 'Ismeretlen hiba'))
      } finally {
        submitBtn.disabled = false
        submitBtn.textContent = originalText
      }
    })
  }
</script>
