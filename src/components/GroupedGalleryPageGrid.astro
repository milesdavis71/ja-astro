---
import { getGroupedGallerySections } from '../utils/groupedGallery'
import schoolNameData from '../data/juniorok-viadala-iskolak.yml'

interface Props {
  title: string
  photographer?: string
  galleryFolder: string
  backToEventUrl?: string
  backToEventLabel?: string
  backToGalleriesUrl?: string
  backToGalleriesLabel?: string
}

const {
  title,
  photographer = '',
  galleryFolder,
  backToEventUrl = '/news',
  backToEventLabel = 'Vissza az eseményhez',
  backToGalleriesUrl = '/fotoalbumok',
  backToGalleriesLabel = 'Vissza a galériákhoz',
} = Astro.props

const schoolNames = (schoolNameData as { schools?: Record<string, string> }).schools || {}
const sections = await getGroupedGallerySections(galleryFolder, schoolNames)
const images = sections.flatMap((section) => section.images)
const galleryId = `gallery-page-${Astro.url.pathname.replace(/[^a-zA-Z0-9]/g, '-')}`
---

<section class="gallery-page" data-gallery-page data-gallery-id={galleryId}>
  <header class="gallery-page__sticky-header">
    <div class="gallery-page__sticky-inner">
      <a href={backToEventUrl} class="gallery-page__link gallery-page__event-link">{backToEventLabel}</a>
      <a href={backToGalleriesUrl} class="gallery-page__link">{backToGalleriesLabel}</a>
    </div>
  </header>

  <div class="gallery-page__container">
    <header class="gallery-page__head">
      <h1 class="gallery-page__title">{title}</h1>
      <p class="gallery-page__meta">
        {photographer && <span>Fotó: {photographer} | </span>}
        <span>{images.length}</span> fotó
      </p>
    </header>

    <div class="gallery-school-list">
      {sections.map((section) => (
        <section class="gallery-school" aria-labelledby={`${galleryId}-${section.slug}`}>
          <h2 id={`${galleryId}-${section.slug}`} class="gallery-school__title">{section.title}</h2>
          <div class="gallery-grid">
            {section.images.map((image) => {
              const index = images.indexOf(image)

              return (
                <button
                  type="button"
                  class="gallery-thumb"
                  data-gallery-thumb
                  data-gallery-index={index}
                  data-gallery-id={galleryId}
                  aria-label={`${index + 1}. kép megnyitása`}
                >
                  <img
                    src={image.thumb || image.src}
                    alt={image.alt || `Galéria kép ${index + 1}`}
                    loading="lazy"
                    decoding="async"
                    class="gallery-thumb__image"
                  />
                  <span class="gallery-thumb__overlay">{index + 1}</span>
                </button>
              )
            })}
          </div>
        </section>
      ))}
    </div>
  </div>

  <button type="button" class="gallery-page__to-top" data-gallery-to-top data-gallery-id={galleryId}>
    Ugrás a tetejére
  </button>

  <div class="gallery-lightbox hidden" data-gallery-lightbox data-gallery-id={galleryId} role="dialog" aria-modal="true">
    <div class="gallery-lightbox__top">
      <div class="gallery-lightbox__counter" data-gallery-counter data-gallery-id={galleryId}>1 / 1</div>
      <div class="gallery-lightbox__buttons">
        <button type="button" class="gallery-lightbox__button" data-gallery-share data-gallery-id={galleryId}>Megosztás</button>
        <button type="button" class="gallery-lightbox__button" data-gallery-copy-link data-gallery-id={galleryId}>Link másolása</button>
        <button type="button" class="gallery-lightbox__button" data-gallery-open-new data-gallery-id={galleryId}>Megnyitás új lapon</button>
        <button type="button" class="gallery-lightbox__button" data-gallery-fullscreen data-gallery-id={galleryId}>Fullscreen</button>
        <button type="button" class="gallery-lightbox__button" data-gallery-close data-gallery-id={galleryId}>Bezárás</button>
      </div>
    </div>

    <button type="button" class="gallery-lightbox__zone gallery-lightbox__zone--left" aria-label="Előző kép" data-gallery-prev-zone data-gallery-id={galleryId}></button>
    <button type="button" class="gallery-lightbox__zone gallery-lightbox__zone--right" aria-label="Következő kép" data-gallery-next-zone data-gallery-id={galleryId}></button>

    <div class="gallery-lightbox__stage" data-gallery-stage data-gallery-id={galleryId}>
      <img src="" alt="" class="gallery-lightbox__image" data-gallery-image data-gallery-id={galleryId} />
    </div>
  </div>

  <script is:inline define:vars={{ galleryId, images }}>
    (() => {
      const rootSelector = `[data-gallery-id="${galleryId}"]`
      const thumbs = Array.from(document.querySelectorAll(`[data-gallery-thumb]${rootSelector}`))
      const toTopButton = document.querySelector(`[data-gallery-to-top]${rootSelector}`)
      const lightbox = document.querySelector(`[data-gallery-lightbox]${rootSelector}`)
      const lightboxImage = document.querySelector(`[data-gallery-image]${rootSelector}`)
      const lightboxStage = document.querySelector(`[data-gallery-stage]${rootSelector}`)
      const lightboxCounter = document.querySelector(`[data-gallery-counter]${rootSelector}`)
      const closeButton = document.querySelector(`[data-gallery-close]${rootSelector}`)
      const prevZone = document.querySelector(`[data-gallery-prev-zone]${rootSelector}`)
      const nextZone = document.querySelector(`[data-gallery-next-zone]${rootSelector}`)
      const shareButton = document.querySelector(`[data-gallery-share]${rootSelector}`)
      const copyLinkButton = document.querySelector(`[data-gallery-copy-link]${rootSelector}`)
      const openNewButton = document.querySelector(`[data-gallery-open-new]${rootSelector}`)
      const fullscreenButton = document.querySelector(`[data-gallery-fullscreen]${rootSelector}`)

      if (!lightbox || !lightboxImage || !lightboxStage || !Array.isArray(images) || !images.length) return

      let currentIndex = 0
      let isOpen = false
      let lockScrollY = 0
      let lastFocusedThumb = null
      let scale = 1
      let translateX = 0
      let translateY = 0
      let lastTapTime = 0
      let pinchStartDistance = 0
      let pinchStartScale = 1
      let panStartX = 0
      let panStartY = 0
      let panOriginX = 0
      let panOriginY = 0
      let touchStartX = 0
      let touchStartY = 0

      const getBaseUrl = () => `${window.location.origin}${window.location.pathname}`
      const getImageUrl = (index) => `${getBaseUrl()}#img-${index + 1}`
      const updateTransform = () => {
        lightboxImage.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`
      }
      const resetZoom = () => {
        scale = 1
        translateX = 0
        translateY = 0
        updateTransform()
      }
      const preloadAround = (index) => {
        const prevIndex = (index - 1 + images.length) % images.length
        const nextIndex = (index + 1) % images.length
        const prevImage = new Image()
        const nextImage = new Image()
        prevImage.src = images[prevIndex].src
        nextImage.src = images[nextIndex].src
      }
      const updateCounter = () => {
        if (lightboxCounter) lightboxCounter.textContent = `${currentIndex + 1} / ${images.length}`
      }
      const setImage = (index) => {
        const max = images.length - 1
        currentIndex = index < 0 ? max : index > max ? 0 : index
        const image = images[currentIndex]
        lightboxImage.src = image.src
        lightboxImage.alt = image.alt || `Galéria kép ${currentIndex + 1}`
        updateCounter()
        preloadAround(currentIndex)
        resetZoom()
        window.history.replaceState({}, '', getImageUrl(currentIndex))
      }
      const lockBodyScroll = () => {
        lockScrollY = window.scrollY
        document.body.style.position = 'fixed'
        document.body.style.top = `-${lockScrollY}px`
        document.body.style.left = '0'
        document.body.style.right = '0'
        document.body.style.width = '100%'
      }
      const unlockBodyScroll = () => {
        document.body.style.position = ''
        document.body.style.top = ''
        document.body.style.left = ''
        document.body.style.right = ''
        document.body.style.width = ''
        window.scrollTo(0, lockScrollY)
      }
      const openLightbox = (index, thumb) => {
        isOpen = true
        lastFocusedThumb = thumb || null
        setImage(index)
        lightbox.classList.remove('hidden')
        lockBodyScroll()
      }
      const closeLightbox = () => {
        if (!isOpen) return
        isOpen = false
        lightbox.classList.add('hidden')
        unlockBodyScroll()
        window.history.replaceState({}, '', getBaseUrl())
        if (lastFocusedThumb instanceof HTMLElement) lastFocusedThumb.focus({ preventScroll: true })
      }
      const nextImage = () => setImage(currentIndex + 1)
      const prevImage = () => setImage(currentIndex - 1)
      const copyCurrentLink = async () => {
        try {
          await navigator.clipboard.writeText(getImageUrl(currentIndex))
        } catch (_error) {}
      }
      const shareCurrent = async () => {
        if (navigator.share) {
          try {
            await navigator.share({ title: document.title, url: getImageUrl(currentIndex) })
          } catch (_error) {}
          return
        }
        await copyCurrentLink()
      }
      const openCurrentInNewTab = () => {
        const image = images[currentIndex]
        if (image) window.open(image.src, '_blank', 'noopener')
      }
      const toggleFullscreen = async () => {
        try {
          if (!document.fullscreenElement) await lightbox.requestFullscreen()
          else await document.exitFullscreen()
        } catch (_error) {}
      }
      const parseHashAndOpen = () => {
        const match = window.location.hash.match(/^#img-(\d+)$/)
        if (!match) return
        const index = Number(match[1]) - 1
        if (index >= 0 && index < images.length) openLightbox(index, null)
      }
      const handleWheelZoom = (event) => {
        if (!isOpen) return
        event.preventDefault()
        scale = Math.max(1, Math.min(4, scale + (event.deltaY < 0 ? 0.2 : -0.2)))
        if (scale === 1) {
          translateX = 0
          translateY = 0
        }
        updateTransform()
      }
      const getDistance = (touches) => {
        const dx = touches[0].clientX - touches[1].clientX
        const dy = touches[0].clientY - touches[1].clientY
        return Math.sqrt(dx * dx + dy * dy)
      }
      const handleTouchStart = (event) => {
        if (!isOpen) return
        if (event.touches.length === 2) {
          pinchStartDistance = getDistance(event.touches)
          pinchStartScale = scale
          return
        }
        const touch = event.touches[0]
        touchStartX = touch.clientX
        touchStartY = touch.clientY
        panStartX = touch.clientX
        panStartY = touch.clientY
        panOriginX = translateX
        panOriginY = translateY
        const now = Date.now()
        if (now - lastTapTime < 280) {
          if (scale > 1) resetZoom()
          else {
            scale = 2
            updateTransform()
          }
        }
        lastTapTime = now
      }
      const handleTouchMove = (event) => {
        if (!isOpen) return
        if (event.touches.length === 2) {
          event.preventDefault()
          const distanceDelta = getDistance(event.touches) / (pinchStartDistance || getDistance(event.touches))
          scale = Math.max(1, Math.min(4, pinchStartScale * distanceDelta))
          if (scale === 1) {
            translateX = 0
            translateY = 0
          }
          updateTransform()
          return
        }
        if (scale > 1 && event.touches.length === 1) {
          event.preventDefault()
          const touch = event.touches[0]
          translateX = panOriginX + (touch.clientX - panStartX)
          translateY = panOriginY + (touch.clientY - panStartY)
          updateTransform()
        }
      }
      const handleTouchEnd = (event) => {
        if (!isOpen || scale > 1) return
        const touch = event.changedTouches[0]
        const deltaX = touch.clientX - touchStartX
        const deltaY = touch.clientY - touchStartY
        if (Math.abs(deltaY) > 90 && Math.abs(deltaX) < 60 && deltaY > 0) {
          closeLightbox()
          return
        }
        if (Math.abs(deltaX) < 50 || Math.abs(deltaY) > 70) return
        if (deltaX < 0) nextImage()
        if (deltaX > 0) prevImage()
      }
      const handleKeydown = (event) => {
        if (!isOpen) return
        if (event.key === 'Escape') closeLightbox()
        if (event.key === 'ArrowRight') nextImage()
        if (event.key === 'ArrowLeft') prevImage()
        if (event.key.toLowerCase() === 'f') toggleFullscreen()
      }

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const index = Number(thumb.getAttribute('data-gallery-index'))
          if (Number.isFinite(index)) openLightbox(index, thumb)
        })
      })
      toTopButton?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))
      closeButton?.addEventListener('click', closeLightbox)
      prevZone?.addEventListener('click', prevImage)
      nextZone?.addEventListener('click', nextImage)
      shareButton?.addEventListener('click', shareCurrent)
      copyLinkButton?.addEventListener('click', copyCurrentLink)
      openNewButton?.addEventListener('click', openCurrentInNewTab)
      fullscreenButton?.addEventListener('click', toggleFullscreen)
      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox) closeLightbox()
      })
      lightboxImage.addEventListener('dblclick', () => {
        if (scale > 1) resetZoom()
        else {
          scale = 2
          updateTransform()
        }
      })
      lightboxStage.addEventListener('wheel', handleWheelZoom, { passive: false })
      lightboxStage.addEventListener('touchstart', handleTouchStart, { passive: false })
      lightboxStage.addEventListener('touchmove', handleTouchMove, { passive: false })
      lightboxStage.addEventListener('touchend', handleTouchEnd, { passive: true })
      window.addEventListener('keydown', handleKeydown)
      parseHashAndOpen()
    })()
  </script>
</section>

<style>
  .gallery-page {
    margin: 1rem auto 0;
  }

  .gallery-page__container {
    margin: 0 auto;
    max-width: 1320px;
    padding: 0.75rem 0.5rem 5rem;
  }

  .gallery-page__sticky-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid #e5e7eb;
  }

  .gallery-page__sticky-inner {
    margin: 0 auto;
    max-width: 1320px;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .gallery-page__link {
    display: inline-flex;
    align-items: center;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #111827;
    background: #ffffff;
    text-decoration: none;
  }

  .gallery-page__head {
    margin: 0.8rem 0 1rem;
  }

  .gallery-page__title {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.2;
    color: #111827;
  }

  .gallery-page__meta {
    margin: 0.45rem 0 0;
    color: #4b5563;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .gallery-school-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .gallery-school__title {
    max-width: 820px;
    margin: 0 auto 0.9rem;
    color: #111827;
    font-size: 1.25rem;
    line-height: 1.25;
    text-align: center;
    text-wrap: balance;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .gallery-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
    background: #f3f4f6;
    cursor: zoom-in;
  }

  .gallery-thumb__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 180ms ease, filter 180ms ease, opacity 180ms ease;
  }

  .gallery-thumb:hover .gallery-thumb__image {
    transform: scale(1.02);
  }

  .gallery-thumb__overlay {
    position: absolute;
    right: 0.45rem;
    bottom: 0.45rem;
    font-size: 0.75rem;
    color: #fff;
    background: rgba(0, 0, 0, 0.45);
    border-radius: 999px;
    padding: 0.15rem 0.45rem;
    pointer-events: none;
  }

  .gallery-page__to-top {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 30;
    border-radius: 999px;
    border: 1px solid var(--button-color);
    background: var(--button-color);
    padding: 0.55rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #fff;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .gallery-page__to-top:hover {
    border-color: var(--button-hover-color);
    background: var(--button-hover-color);
  }

  .gallery-lightbox.hidden {
    display: none;
  }

  .gallery-lightbox {
    position: fixed;
    inset: 0;
    z-index: 120;
    background: rgba(10, 10, 10, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: none;
  }

  .gallery-lightbox__top {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem;
    z-index: 4;
  }

  .gallery-lightbox__counter {
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .gallery-lightbox__buttons {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .gallery-lightbox__button {
    border: 1px solid var(--button-color);
    color: #fff;
    background: var(--button-color);
    border-radius: 8px;
    padding: 0.4rem 0.55rem;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .gallery-lightbox__button:hover {
    border-color: var(--button-hover-color);
    background: var(--button-hover-color);
  }

  .gallery-lightbox__stage {
    width: min(95vw, 1500px);
    max-height: 92vh;
    aspect-ratio: 3 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .gallery-lightbox__image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transform-origin: center center;
    transition: transform 120ms ease;
    user-select: none;
  }

  .gallery-lightbox__zone {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 26%;
    border: 0;
    background: transparent;
    cursor: pointer;
    z-index: 3;
  }

  .gallery-lightbox__zone--left {
    left: 0;
  }

  .gallery-lightbox__zone--right {
    right: 0;
  }

  @media (min-width: 421px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }
  }

  @media (min-width: 769px) {
    .gallery-page__container {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .gallery-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .gallery-page__title {
      font-size: 1.8rem;
    }

    .gallery-school__title {
      font-size: 1.45rem;
    }
  }

  @media (min-width: 1025px) {
    .gallery-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 13px;
    }
  }

  @media (min-width: 1441px) {
    .gallery-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 14px;
    }
  }
</style>
