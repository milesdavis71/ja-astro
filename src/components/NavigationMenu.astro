---
import NavigationMenuItem from './NavigationMenuItem.astro'

const { menu, customClass = '' } = Astro.props
const currentPath = Astro.url.pathname
---

<nav class={`p-4 ${customClass}`} aria-label="Fő navigáció">
  <ul class="list-none space-y-1 pl-0">
    {menu.map((item: any) => <NavigationMenuItem item={item} currentPath={currentPath} />)}
  </ul>
</nav>
